PUBLIC_URL=https://remote.example.com
NODE_SECRET=change-this-to-a-long-random-secret
ALLOW_ORIGIN=*
INVITE_TTL_SECONDS=900
MAX_INVITE_TTL_SECONDS=86400
MAX_VIEWERS_PER_SESSION=4
PORT=8096

# Optional TURN relay for networks where direct WebRTC cannot connect.
TURN_URL=turn:remote.example.com:3478
TURN_USERNAME=nekodroid
TURN_PASSWORD=change-this-turn-password

TURN_REALM=remote.example.com
